{
  "name": "dsh-tool-hub",
  "version": "0.1.0",
  "description": "One panel to list, group, and switch on or off the plugins and skills an installation runs, with saved presets and rule-based auto grouping.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugins",
    "skills",
    "manager"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "client",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-0 <5.0.0-0"
  }
}
